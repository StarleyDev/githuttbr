{
  "name": "githuttbr",
  "productName": "GitHuttBr",
  "desktopName": "githuttbr.desktop",
  "version": "4.59.1",
  "description": "A lightweight Git client built with Electron, React and clean architecture",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.22.2"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/StarleyDev/githuttbr",
  "author": {
    "name": "Starley - Mestre Jedi",
    "email": "9012499+StarleyDev@users.noreply.github.com",
    "url": "https://github.com/StarleyDev"
  },
  "scripts": {
    "dev": "electron-vite dev -w",
    "build": "node scripts/sync-grammars.mjs && node scripts/gen-licenses.mjs && electron-vite build",
    "dist:mac": "node scripts/check-native.mjs && electron-builder --mac",
    "dist:win": "node scripts/check-native.mjs && electron-builder --win",
    "dist:linux": "node scripts/check-native.mjs && electron-builder --linux",
    "release": "npm run build && node scripts/check-native.mjs && electron-builder --publish always",
    "release:patch": "release-it --increment patch",
    "release:minor": "release-it --increment minor",
    "release:major": "release-it --increment major",
    "preview": "electron-vite preview",
    "playground": "bash examples/setup-playground.sh",
    "playground:rebuild": "PLAYGROUND_FORCE=1 bash examples/setup-playground.sh",
    "screenshots": "node examples/screenshots/capture.mjs",
    "screenshots:clips": "node examples/screenshots/capture.mjs --clips",
    "screenshots:gif": "node examples/screenshots/capture.mjs --clips",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:docs": "node scripts/docs-check.mjs",
    "licenses": "node scripts/gen-licenses.mjs",
    "check:native": "node scripts/check-native.mjs",
    "audit:electron": "node scripts/audit-electron.mjs",
    "site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/build-site.mjs && npx --yes serve dist-site",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky",
    "playground:monster": "bash examples/monster-repo.sh",
    "repo:stats": "bash examples/repo-stats.sh"
  },
  "build": {
    "appId": "com.huttbr.git",
    "productName": "GitHuttBr",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "./scripts/after-pack.cjs",
    "files": [
      "out/**/*",
      "resources/**",
      "!resources/tree-sitter/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/cli",
        "to": "cli"
      },
      {
        "from": "resources/tree-sitter",
        "to": "tree-sitter"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "StarleyDev",
      "repo": "githuttbr"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "executableName": "githuttbr",
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "githuttbr"
        }
      }
    }
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.7",
    "@simple-git/argv-parser": "3.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "blobatar": "^2.5.0",
    "dompurify": "^3.4.18",
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.14.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.3.2",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.80.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "pptx-preview": "^1.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-git": "^4.1.0",
    "three": "^0.187.0",
    "web-tree-sitter": "^0.27.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.1.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "^4.2.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "@tree-sitter-grammars/tree-sitter-lua": "^0.4.1",
    "@tree-sitter-grammars/tree-sitter-zig": "^1.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "playwright": "^1.61.0",
    "release-it": "^21.1.3",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.24.0",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "pptx-preview": {
      "echarts": "^6.1.0",
      "uuid": "^11.1.1"
    }
  }
}
